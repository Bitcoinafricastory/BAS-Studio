# --- Anthropic ---
# Used for: draft generation ("write in my voice"), market radar (web-search summarization),
# and the Assistant chat.
ANTHROPIC_API_KEY=

# --- xAI (Grok) — optional ---
# Powers the "X radar" signal on the Leads screen and the Grok option in the Home chat's
# model toggle. Both features fail closed (silently skip / show an error, no crash) if this
# is left blank — everything else works fine without it.
XAI_API_KEY=

# --- Firebase (client SDK — same project as your main site) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side writes to the `news` collection) ---
# Generate a service account key in Firebase Console > Project Settings > Service Accounts.
# Paste the full JSON as a single-line string (escape newlines in the private key with \n).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Passcode gate ---
# Simple shared passcode for the light auth gate — not a full user system.
BAS_STUDIO_PASSCODE=

# --- Transcription (local Whisper) ---
# No API key needed — transcription runs locally on your machine. Requires:
#   1. Python 3 + ffmpeg installed
#   2. pip install -U openai-whisper
#   3. For YouTube fallback (only used when a video has no captions): pip install yt-dlp
# Nothing to fill in here; this section exists so the requirement isn't a surprise.
